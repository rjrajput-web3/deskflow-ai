# DeskFlow AI — copy to .env.local and fill only what you have. NEVER commit real keys.
# Supabase (free tier) — required for real auth/database in Sprint 2. Leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini (free tier) — enables the live AI Test Sandbox. Leave empty for the built-in mock responder.
GEMINI_API_KEY=
# Meta WhatsApp Cloud API — sandbox credentials, added only when Meta onboarding is done.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
